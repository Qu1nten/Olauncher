<?xml version="1.0" encoding="utf-8"?>
<!-- Shown under a home widget while it's being edited -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Slideshow widget only -->
    <LinearLayout
        android:id="@+id/slideshowIntervalRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:text="@string/change_every"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/slideshowInterval"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="10dp"
            android:paddingStart="16dp"
            android:textSize="16sp"
            tools:ignore="RtlSymmetry"
            tools:text="5 s" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/slideshowPhotosRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:text="@string/photos"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/slideshowPhotos"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="10dp"
            android:paddingStart="16dp"
            android:text="@string/change"
            android:textSize="16sp"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:text="@string/interactive"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widgetInteractive"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="10dp"
            android:paddingStart="16dp"
            android:text="@string/on"
            android:textSize="16sp"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetRemove"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="10dp"
            android:paddingEnd="16dp"
            android:text="@string/remove_widget"
            android:textSize="16sp"
            tools:ignore="RtlSymmetry" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widgetDone"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="10dp"
            android:paddingStart="16dp"
            android:text="@string/done"
            android:textSize="16sp"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>
</LinearLayout>
