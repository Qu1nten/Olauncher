<?xml version="1.0" encoding="utf-8"?>
<!-- Shown under a home widget while it's being edited -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widgetMoveUp"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:paddingVertical="10dp"
        android:paddingEnd="16dp"
        android:text="@string/move_up"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widgetMoveDown"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:paddingVertical="10dp"
        android:paddingEnd="16dp"
        android:text="@string/move_down"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widgetRemove"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:paddingVertical="10dp"
        android:paddingEnd="16dp"
        android:text="@string/remove_widget"
        android:textSize="16sp" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widgetDone"
        style="@style/TextSmallBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:paddingVertical="10dp"
        android:paddingStart="16dp"
        android:text="@string/done"
        android:textSize="16sp" />
</LinearLayout>
