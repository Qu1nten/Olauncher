<?xml version="1.0" encoding="utf-8"?>
<!-- A slideshow photo shown full screen, with what can be done with it -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Pinch or double tap to zoom; a single tap closes the photo -->
    <app.olauncher.helper.ZoomImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/delete"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/delete_photo_action"
            android:textColor="@android:color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/open"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/open_photo"
            android:textColor="@android:color/white" />

        <!-- Upright: previous and next sit in this bar; sideways they move to the screen's sides -->
        <TextView
            android:id="@+id/previous"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/previous_photo"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/next"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/next_photo"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/close"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/close"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/previousSide"
        style="@style/TextSmallBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:background="#80000000"
        android:focusable="true"
        android:padding="16dp"
        android:text="@string/previous_photo"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nextSide"
        style="@style/TextSmallBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:background="#80000000"
        android:focusable="true"
        android:padding="16dp"
        android:text="@string/next_photo"
        android:textColor="@android:color/white"
        android:visibility="gone" />
</FrameLayout>
